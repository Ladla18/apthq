# API base URL (direct upstream, no proxy)
VITE_API_BASE=https://zq64cz3rlu4mddosjkdnqvto2e0evpei.lambda-url.ap-south-1.on.aws

# OTP auth API base (request-otp / verify-otp)
VITE_AUTH_API_BASE=https://zq64cz3rlu4mddosjkdnqvto2e0evpei.lambda-url.ap-south-1.on.aws

# Dev proxy targets (vite.config.ts only, not exposed to client)
# 1. Analytics & Health Lambda proxy target:
VITE_API_PROXY_TARGET=https://zq64cz3rlu4mddosjkdnqvto2e0evpei.lambda-url.ap-south-1.on.aws

# 2. Brand Config / Login (/v2) — Apt demo API (default). For local mock data use http://localhost:3000 + npm run server
# 2. Brand Config / Login (/v2/aggregate, /v2/users/login)
# Local default: mock server on port 3000 (run `npm run server` in a second terminal) — same as Vercel deploy.
# Set VITE_BRAND_CONFIG_USE_APTDEMO=true to hit real aptdemo instead (needs session_token cookie).
VITE_BRAND_CONFIG_MOCK_TARGET=http://localhost:3000

# Other /v2 routes (if any) — aptdemo
VITE_V2_PROXY_TARGET=https://api.aptdemo.atoms.trade

# 3. Health Check v3 proxy target for /v3 (default: https://api.webtest.apt.trading)
VITE_HEALTH_V3_PROXY_TARGET=https://api.webtest.apt.trading

# Health Check v3 and strategy lookup — call this host directly
VITE_HEALTH_V3_API_BASE=https://api.webtest.apt.trading

# Optional: session_token UUID for Brand Config tab (paste in UI is easier)
# VITE_BRAND_CONFIG_TOKEN=

# Partner chat/ticket API base (used by Chat Tickets tab)
VITE_CHAT_API_BASE=https://api.apt.trading
